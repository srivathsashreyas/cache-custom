# Copy to deploy/.env and fill in values. deploy/.env is gitignored.
# Purpose: non-secret deploy knobs shared by scripts and documented for GitHub Actions vars.
# Auth is NOT here — use `gcloud auth login` locally or Workload Identity Federation in CI.

# --- GCP project / region ----------------------------------------------------
PROJECT_ID=my-gcp-project
REGION=us-central1

# --- GKE ---------------------------------------------------------------------
# Cluster name used by create-cluster and get-credentials scripts.
CLUSTER_NAME=cache-custom
# autopilot | standard
CLUSTER_TYPE=autopilot
# Only used when CLUSTER_TYPE=standard (zonal cluster for lower cost/dev).
ZONE=us-central1-a

# --- Artifact Registry -------------------------------------------------------
# Docker repository id (not the full path). Created by 02-create-artifact-registry.sh.
AR_REPOSITORY=cache-custom
# Image name within the repository.
IMAGE_NAME=cache-custom
# Tag for build/push (CI often sets this to git SHA).
IMAGE_TAG=latest

# Full image is derived as:
#   ${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPOSITORY}/${IMAGE_NAME}:${IMAGE_TAG}

# --- Kubernetes / Helm -------------------------------------------------------
NAMESPACE=cache-custom
HELM_RELEASE=cache-custom
# Path to chart relative to repo root (used by scripts).
HELM_CHART=deploy/helm/cache-custom
# Set to true to enable PVC + StatefulSet (also set Persistence.Mode in values/serverConfig).
PERSISTENCE_ENABLED=false

# --- GitHub Actions WIF (used by 00-setup-wif-github.sh only) -----------------
# owner/repo allowed to federate (must match the GitHub repository running Actions).
GITHUB_REPO=srivathsashreyas/cache-custom
# Workload Identity pool + OIDC provider ids (resource names, not full paths).
WIF_POOL_ID=github-pool
WIF_PROVIDER_ID=github-provider
# Deploy SA id (email becomes ${DEPLOY_SA_ID}@${PROJECT_ID}.iam.gserviceaccount.com).
# Reused if it already exists (e.g. github-deploy).
DEPLOY_SA_ID=github-deploy

# --- Optional overrides ------------------------------------------------------
# Extra helm --set flags (space-separated), e.g. resources.requests.memory=512Mi
# HELM_EXTRA_SET=
