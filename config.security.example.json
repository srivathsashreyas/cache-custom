{
  "Security": {
    "Profile": "protected",
    "RequireAuth": true,
    "MaxClients": 1000,
    "IdleTimeoutSec": 300,
    "DenyCommands": ["FLUSHDB"],
    "TLSCertFile": "certs/server.pem",
    "TLSKeyFile": "certs/server.key",
    "TLSClientCA": "",
    "TLSMinVersion": "1.2"
  },
  "Persistence": {
    "Mode": "none",
    "Dir": "data"
  },
  "Tenants": [
    {
      "Name": "App1",
      "Password": "secret1",
      "AppId": 1,
      "MaxMemory": 1048576,
      "EvictionPolicy": "allkeys-lru",
      "MaxTTL": 3600,
      "ShardCount": 4,
      "ShardingStrategy": 1,
      "MaxClients": 100
    },
    {
      "Name": "App2",
      "Password": "secret2",
      "AppId": 2,
      "MaxMemory": 65536,
      "EvictionPolicy": "allkeys-fifo",
      "MaxTTL": 3600,
      "ShardCount": 4,
      "ShardingStrategy": 2,
      "MaxClients": 50
    }
  ]
}
